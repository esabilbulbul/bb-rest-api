    <!-- !!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
    <!--          Start Path          -->
    <!-- !!!!!!!!!!!!!!!!!!!!!!!!!!!! -->
        <servlet-mapping>
            <servlet-name>jaxesa</servlet-name><!-- make sure same name with the one defined in SERVLET section here -->
            <url-pattern>/rest/bb/*</url-pattern>
        </servlet-mapping>

</web-app>
